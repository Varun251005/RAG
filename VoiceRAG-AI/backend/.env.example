# VoiceRAG AI Backend Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000

# Google Gemini API Key
GEMINI_API_KEY=

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=voicerag

# Edge-TTS Voice Configuration
TTS_DEFAULT_VOICE=en-US-AvaNeural
TTS_DEFAULT_RATE=+0%
